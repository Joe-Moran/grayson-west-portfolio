---
interface Props {
  title: string;
  href: string;
  image?: string;      // URL string
  background?: string; // URL string
  label?: string;
}

const { title, href, image, background, label } = Astro.props;
---

<a href={href} class="work-card">
  {background && <img src={background} alt="" class="work-card-bg" loading="lazy" />}

  {image && <img src={image} alt={title} class="work-card-fg" loading="lazy" />}

  <div class="work-card-content">
	<h2>{title}</h2>
	{label && <p>{label}</p>}
  </div>
</a>

<style>
  .work-card {
	position: relative;
	overflow: hidden;
	border-radius: 12px;
	text-decoration: none;
	background: #0e1015;
	color: var(--white);
	display: flex;
	align-items: flex-end;
	min-height: 260px;
	padding: 16px;
	box-sizing: border-box;

	/* defaults for screenshot sizing / positioning */
	--screenshot-max-width: 80%;
	--screenshot-max-height: 60%;
	--screenshot-translate-y: -55%;
  }

  .work-card-bg {
	position: absolute;
	inset: 0;
	width: 100%;
	height: 100%;
	object-fit: cover;
	filter: brightness(0.7);
	z-index: 0;
  }

  .work-card-fg {
	position: absolute;
	top: 50%;
	left: 50%;
	transform: translate(-50%, var(--screenshot-translate-y));
	max-width: var(--screenshot-max-width);
	max-height: var(--screenshot-max-height);
	object-fit: contain;
	background: transparent;

	border-radius: 10px;
	box-shadow: none;
	z-index: 2;
	transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .work-card-content {
	position: relative;
	z-index: 1;
	display: flex;
	flex-direction: column;
	padding: 14px 16px 16px;

	background: rgba(0, 0, 0, 0.5);
	backdrop-filter: blur(4px);
	border-radius: 8px;
  }

  .work-card h2 {
	margin: 0 0 4px 0;
	font-size: 1.5rem;
	font-weight: 800;
	text-transform: uppercase;
	letter-spacing: 0.04em;
	color: var(--orange);
  }

  .work-card p {
	margin: 0;
	font-size: 0.95rem;
	line-height: 1.5;
	color: var(--muted-text, #c9ced8);
  }

  .work-card:hover .work-card-fg {
	transform: translate(-50%, calc(var(--screenshot-translate-y) - 5%));
	box-shadow: none;
  }

  .work-card:hover {
	box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
  }
</style>