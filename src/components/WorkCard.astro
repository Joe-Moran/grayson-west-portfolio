---
import { screenshotColors, screenshotShadow } from '../lib/screenshotStyles.js';

interface Props {
  title: string;
  href: string;
  image?: string;      // URL string
  background?: string; // URL string
  label?: string;
  imageAlt?: string;
  frameColor?: keyof typeof screenshotColors;
  imageRatio?: number;
}

const { title, href, image, background, label, imageAlt, frameColor, imageRatio = 1.5 } = Astro.props;
---

<a href={href} class:list={['work-card', { 'work-card-with-image': Boolean(image) }]}>
  {background && <img src={background} alt="" class="work-card-bg" loading="lazy" />}

  {image && (frameColor ? (
    <div class="work-card-preview">
      <div class="work-card-frame" style={{
        '--frame-color': screenshotColors[frameColor],
        '--screenshot-shadow': screenshotShadow,
        '--preview-width': `min(100%, ${260 * imageRatio}px)`,
      }}>
        <img src={image} alt={imageAlt || title} loading="lazy" />
      </div>
    </div>
  ) : (
    <div class="work-card-preview">
      <img src={image} alt={imageAlt || title} class="work-card-fg" loading="lazy" />
    </div>
  ))}

  <div class="work-card-content">
	<h2>{title}</h2>
	{label && <p>{label}</p>}
  </div>
</a>

<style>
  .work-card {
	position: relative;
	box-sizing: border-box;
	display: flex;
	align-items: flex-end;
	min-height: 260px;
	padding: 16px;
	overflow: hidden;
	color: var(--white);
	text-decoration: none;
	background: #0e1015;
	border-radius: 12px;

	/* defaults for screenshot sizing / positioning */
	--screenshot-max-width: 80%;
	--screenshot-max-height: 60%;
	--screenshot-translate-y: -55%;
  }

  .work-card-with-image {
    display: grid;
    grid-template-rows: minmax(260px, 1fr) auto;
    gap: 20px;
    align-items: stretch;
  }

  .work-card-preview {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    min-width: 0;
    padding: 12px;
  }

  .work-card-frame {
    box-sizing: border-box;
    width: var(--preview-width);
    padding: 2%;
    background: var(--frame-color);
    border-radius: 10px;
  }

  .work-card-frame img {
    display: block;
    width: 100%;
    height: auto;
    filter: var(--screenshot-shadow);
  }

  .work-card-bg {
	position: absolute;
	inset: 0;
	z-index: 0;
	width: 100%;
	height: 100%;
	object-fit: cover;
	filter: brightness(0.7);
  }

  .work-card-fg {
    display: block;
    max-width: 100%;
    max-height: 260px;
    object-fit: contain;
    border-radius: 10px;
    transition: transform 0.2s ease;
  }

  .work-card-content {
	position: relative;
	z-index: 1;
	display: flex;
	flex-direction: column;
	padding: 14px 16px 16px;
	background: rgb(0 0 0 / 50%);
	backdrop-filter: blur(4px);
	border-radius: 8px;
  }

  .work-card h2 {
	margin: 0 0 4px;
	font-size: 1.5rem;
	font-weight: 800;
	color: var(--orange);
	text-transform: uppercase;
	letter-spacing: 0.04em;
  }

  .work-card p {
	margin: 0;
	font-size: 0.95rem;
	line-height: 1.5;
	color: var(--muted-text, #c9ced8);
  }

  .work-card:hover .work-card-fg {
	box-shadow: none;
	transform: translateY(-4px);
  }

  .work-card:hover {
	box-shadow: 0 10px 30px rgb(0 0 0 / 45%);
  }
</style>