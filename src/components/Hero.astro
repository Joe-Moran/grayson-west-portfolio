---
import BackgroundImage from './BackgroundImage.astro';
import defaultHero from '../assets/hero.jpeg';

interface Props {
  title: string;
  image?: any;
}

const { title, image } = Astro.props;
const heroImage = image ?? defaultHero;
---

<div class='hero'>
  <BackgroundImage image={heroImage} alt='' class:list={['image']} />

  <div class='heading-container'>
    <h1 class='heading'>{title}</h1>
  </div>
</div>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: 279px;
    padding: clamp(12px, 4vw, 25px);
    background: gray;
  }

  .heading-container {
    position: relative;
    z-index: 2;
    display: flex;
    align-self: flex-end;
  }

  .heading {
    flex: 10;
    padding: 20px;
    font-size: clamp(1.4rem, 10vw, 2.25rem);
    font-style: italic;
    font-weight: 900;
    color: var(--orange);
    text-transform: uppercase;
    background: var(--color-heading-background);
  }
</style>