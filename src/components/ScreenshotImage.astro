---
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  background?: 'rust' | 'gold' | 'plum';
  padding?: 'small' | 'medium' | 'large';
  aspectRatio?: 'auto' | '4/3' | '16/9' | '1/1';
  imageWidth?: number;
  rounded?: boolean;
  shadow?: boolean;
}

const {
  src, alt, caption, background = 'rust', padding = 'medium',
  aspectRatio = 'auto', imageWidth = 100, rounded = false, shadow = true,
} = Astro.props;
const colors = { rust: '#a95248', gold: '#f7c163', plum: '#4d444e' };
const spacing = {
  small: '1%',
  medium: '2%',
  large: '3%',
};
const resolvedSrc = typeof src === 'string' ? src : src.src;
---

<figure class="screenshot">
  <button
    type="button"
    class="screenshot-frame"
    style={{
      '--frame-color': colors[background],
      '--frame-padding': spacing[padding],
      '--frame-ratio': aspectRatio,
      '--image-width': `${Math.min(100, Math.max(1, imageWidth))}%`,
    }}
    data-lightbox-src={resolvedSrc}
    data-lightbox-alt={alt}
    data-lightbox-caption={caption || ''}
    aria-label={`Enlarge: ${alt}`}
  >
    <img
      src={resolvedSrc}
      alt={alt}
      width={typeof src === 'string' ? undefined : src.width}
      height={typeof src === 'string' ? undefined : src.height}
      class:list={{ rounded, shadow }}
      loading="lazy"
      decoding="async"
    />
  </button>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .screenshot {
    margin: 0 0 1.5rem;
  }

  .screenshot-frame {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: var(--frame-ratio);
    padding: var(--frame-padding);
    cursor: zoom-in;
    background: var(--frame-color);
    border: 0;
    border-radius: 10px;
  }

  .screenshot-frame:focus-visible {
    outline: 3px solid var(--color-heading, #ffc052);
    outline-offset: 4px;
  }

  .screenshot-frame img {
    display: block;
    width: var(--image-width);
    max-width: 100%;
    height: auto;
    max-height: 100%;
    margin: 0;
    object-fit: contain;
  }

  .screenshot-frame .rounded {
    border-radius: 8px;
  }

  .screenshot-frame .shadow {
    filter: drop-shadow(0 8px 12px rgb(0 0 0 / 45%));
  }

  .screenshot figcaption {
    margin-top: 0.5rem;
    font-family: Poppins, sans-serif;
    font-size: 0.95rem;
    line-height: 1.4;
    text-align: center;
  }
</style>
