---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';

// Bypass Astro's /_image pipeline for this one SVG (prevents clipping)
import instagramIconUrl from '../assets/instagram-2-logo.svg?url';

const content = await getEntry('footer', 'footer');
---

<footer class="footer">
  <div class="main-content">
    <span class="site-name">{content.data.title}</span>
    <a href={`mailto:${content.data.email}`}>{content.data.email}</a>
  </div>

  <nav class="footer-nav" aria-label="footer links">
    <a href="https://patternflux.com" class="footer-writing">
      Writing
    </a>

    {
      content.data.links.map((link) => (
        <a href={link.url} aria-label={link.title}>
          {link.image != undefined ? (
            link.title.toLowerCase() === 'instagram' ? (
              <img
                class={`footer-icon footer-icon--${link.title.toLowerCase()}`}
                src={instagramIconUrl}
                alt={link.title}
                width="26"
                height="26"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <Image
                class={`footer-icon footer-icon--${link.title.toLowerCase()}`}
                src={link.image}
                alt={link.title}
                format="svg"
                width={26}
                height={26}
              />
            )
          ) : (
            link.title
          )}
        </a>
      ))
    }
  </nav>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    padding: 38px 29px;
    color: var(--color-logo);
    background: var(--color-heading-background);

    .main-content {
      display: flex;
      flex: 1;
      flex-wrap: wrap;
      align-items: center;
      white-space: nowrap;
    }
  }

  .footer-nav {
    display: flex;
    gap: 36px;
    align-items: center;
  }

  /* Keep nav items vertically aligned */
  .footer-nav a {
    display: inline-flex;
    align-items: center;
  }

  .footer-icon {
    display: block;
    line-height: 0;
    object-fit: contain;
  }

  /* Icon-style logos */
  .footer-icon--instagram {
    width: 26px;
    height: 26px;
  }

  /* Wordmark-style logos */
  .footer-icon--linkedin {
    height: 26px;
    width: auto;
  }

  /* “Writing” should sit nicely with icons */
  .footer-writing {
    line-height: 1;
  }

  .site-name {
    margin-right: 36px;
    font-size: clamp(1.125rem, 7vw, 1.75rem);
    font-style: italic;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
  }

  a {
    font-size: clamp(1rem, 4vw, 1rem);
    font-weight: 700;
    color: inherit;
    text-decoration-color: transparent;
    transition: 250ms ease-in-out text-decoration-color;

    &:hover,
    &:focus {
      text-decoration-color: inherit;
    }
  }
</style>