---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import Hero from '../components/Hero.astro';
import Values from '../components/Values.astro';
import Intro from '../components/Intro.astro';
import WorkCard from '../components/WorkCard.astro';

// Card images
import uxCard from '../assets/home-cards/home-card-ux.png';
import visualCard from '../assets/home-cards/home-card-visual.png';
import photoCard from '../assets/home-cards/home-card-photo.png';
import soundCard from '../assets/home-cards/home-card-sound.png';

const introEntry = await getEntry('intro', 'paragraph');
const { Content } = await introEntry.render();
const title = 'Grayson Gail West';
---

<Layout title={title}>
  <Hero title={title} />

  <div class="intro-container">
    <Intro title={introEntry.data.title} greeting={introEntry.data.greeting}>
      <div class="intro-content">
        <Content />
      </div>
    </Intro>
  </div>

  <Values />

<section class="home-section" aria-label="Work areas">
    <div class="home-grid">
      <WorkCard
        title="UX"
        href="/ux"
        background={uxCard.src}
        label="User experience, product design, and strategy case studies."
      />
  
      <WorkCard
        title="Visual"
        href="/visual"
        background={visualCard.src}
        label="Graphic design, motion graphics, and video experiments."
      />
  
      <WorkCard
        title="Photo"
        href="/photo"
        background={photoCard.src}
        label="Photography that sharpens composition, light, and timing."
      />
  
      <WorkCard
        title="Sound"
        href="/sound"
        background={soundCard.src}
        label="Sound design, field recordings, and ambient music practice."
      />
    </div>
  </section>
</Layout>

<style>
  .home-section {
    padding-inline: clamp(12px, 4vw, 25px);
    padding-bottom: 42px;
  }

  .home-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }

  @media (width <= 720px) {
    .home-grid {
      grid-template-columns: 1fr;
    }
  }
</style>