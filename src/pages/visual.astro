---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import WorkCard from '../components/WorkCard.astro';

const portfolioCollection = await getCollection('portfolio', ({ data }) =>
  data.disciplines?.includes('visual')
);
---

<Layout title="Visual & Motion">
  <Hero title="Visual & Motion" />

  <main id="main">
	<div class="intro-container">
	  <Intro greeting="Visual design, motion graphics, and video work." title="Visual & Motion">
		<div class="intro-content">
		  <p>
			This section brings together my visual practice: graphic design, motion graphics, and
			video. I use these mediums to explore rhythm, typography, composition, and storytelling
			in ways that complement my UX work.
		  </p>
		  <p>
			Below is a reusable grid of case studies using the same card layout as my UX section.
			Over time, this will evolve to highlight visual and motion-focused projects.
		  </p>
		</div>
	  </Intro>
	</div>

	<section class="discipline-section discipline-section--visual" aria-label="Visual & Motion work">
	  <div class="discipline-grid">
		{
		  portfolioCollection
			.filter((item) => item.data.title.toLowerCase() !== 'template')
			.sort((a, b) => a.data.order - b.data.order)
			.map((item) => {
			  const img =
				'screenshot' in item.data && item.data.screenshot?.image
				  ? item.data.screenshot.image
				  : item.data.background;

			  const label =
				Array.isArray(item.data.platforms) && item.data.platforms.length
				  ? item.data.platforms.join(' · ')
				  : '';

			  return (
				<WorkCard
				  title={item.data.title}
				  href={`/the-work/${item.slug}`}
				  image={img}
				  label={label}
				/>
			  );
			})
		}
	  </div>
	</section>
  </main>
</Layout>

<style>
  .discipline-section {
	padding-inline: clamp(12px, 4vw, 25px);
	padding-bottom: 42px;
  }

  .discipline-grid {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 28px;
  }

  @media (max-width: 720px) {
	.discipline-grid {
	  grid-template-columns: 1fr;
	}
  }

  /* Per-page card height for Visual */
  .discipline-section--visual .work-card {
	min-height: 220px; /* tweak this if you want taller/shorter */
  }
</style>