---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { getEntry } from 'astro:content';

const aboutEntry = await getEntry('about', 'me');
const { Content } = await aboutEntry.render();
---

<Layout title="About">
  <Hero title="About Me" />

  <article class="about-body">
	<Content />
  </article>
</Layout>

<style>
  .about-body {
	max-width: 60ch;
	margin-inline: auto;
	padding: 0 16px 48px;
	line-height: 1.6;
  }

  .about-body h2 {
	margin-top: 2rem;
	margin-bottom: 0.75rem;
  }

  .about-body p + p {
	margin-top: 1rem;
  }

  .about-body ul {
	padding-left: 1.3rem;
	margin-top: 1rem;
  }
</style>