---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import WorkCard from '../components/WorkCard.astro';

const portfolioCollection = await getCollection('portfolio', ({ data }) =>
  data.disciplines?.includes('sound')
);
---

<Layout title="Sound & Music">
  <Hero title="Sound & Music" />

  <main id="main">
	<div class="intro-container">
	  <Intro greeting="This section brings together my sound and music practice." title="Sound & Music">
		<div class="intro-content">
		  <p>
			This section explores sound design, ambient music, and experimental audio work that
			informs how I think about pacing, rhythm, and atmosphere in product design.
		  </p>
		</div>
	  </Intro>
	</div>

	<section class="discipline-section discipline-section--sound" aria-label="Sound & Music work">
	  <div class="discipline-grid">
		{
		  portfolioCollection
			.filter((item) => item.data.title.toLowerCase() !== 'template')
			.sort((a, b) => a.data.order - b.data.order)
			.map((item) => {
			  const img =
				'screenshot' in item.data && item.data.screenshot?.image
				  ? item.data.screenshot.image
				  : item.data.background;

			  const label =
				Array.isArray(item.data.platforms) && item.data.platforms.length
				  ? item.data.platforms.join(' · ')
				  : '';

			  return (
				<WorkCard
				  title={item.data.title}
				  href={`/the-work/${item.slug}`}
				  image={img}
				  label={label}
				/>
			  );
			})
		}
	  </div>
	</section>
  </main>
</Layout>

<style>
  .discipline-section {
	padding-inline: clamp(12px, 4vw, 25px);
	padding-bottom: 42px;
  }

  .discipline-grid {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 28px;
  }

  @media (max-width: 720px) {
	.discipline-grid {
	  grid-template-columns: 1fr;
	}
  }

  /* Per-page card height for Sound */
  .discipline-section--sound .work-card {
	min-height: 210px;
  }
</style>