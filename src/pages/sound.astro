---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
---

<Layout title="Sound & Music">
  <Hero title="Sound & Music" />

  <main id="main">
	<div class="intro-container">
	  <Intro greeting="This section brings together my Sound & Music.">
		<div class="intro-content">
		  <p>
			This section brings together my visual practice: graphic design, motion graphics, and video. I use these mediums to explore rhythm, typography, composition, and storytelling in ways that complement my UX work.
		  </p>
		</div>
	  </Intro>
	</div>
</Layout>