---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import ContentPreviewMasonry from '../components/ContentPreviewMasonry.astro';

const portfolioCollection = await getCollection('portfolio', ({ data }) =>
  data.disciplines?.includes('sound')
);
---

<Layout title="Sound & Music">
  <Hero title="Sound & Music" />

  <div class="intro-container">
	<Intro greeting="This section brings together my sound, music, and field recording work.">
	  <div class="intro-content">
		<p>
		  This section focuses on sound design, music experiments, and field recordings that
		  influence how I think about rhythm, pacing, and atmosphere in product and visual design.
		</p>
		<p>
		  Over time, this will grow into a collection of sonic studies that sit alongside my UX,
		  visual, and photography practice.
		</p>
	  </div>
	</Intro>
  </div>

  <ContentPreviewMasonry
	basePath="/the-work"
	collection={portfolioCollection}
	previewLocation="page-preview"
  />
</Layout>