---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LightboxGlobal from '../components/LightboxGlobal.astro';
import type { WebPage } from '../types/Page.mts';

interface Props {
  title: string;
  subPages?: WebPage[];
  currentDiscipline?: 'ux' | 'visual' | 'photo' | 'sound';
}

const siteTitle = 'Grayson Gail West';
const { title, currentDiscipline } = Astro.props;

const titleFormatted = title === siteTitle ? siteTitle : `${title} | ${siteTitle}`;
import '../styles/index.css';

const mainLandmarkId = 'main-content';

// ✅ Infer discipline from URL for discipline pages,
// but allow explicit prop override for /the-work/* pages.
const currentPath = new URL(Astro.request.url).pathname;

const inferredDiscipline =
  currentPath.startsWith('/ux')
    ? 'ux'
    : currentPath.startsWith('/visual')
    ? 'visual'
    : currentPath.startsWith('/photo')
    ? 'photo'
    : currentPath.startsWith('/sound')
    ? 'sound'
    : undefined;

const resolvedDiscipline = currentDiscipline ?? inferredDiscipline;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{titleFormatted}</title>
  </head>

  <body>
    <Header mainLandmarkId={mainLandmarkId} currentDiscipline={resolvedDiscipline} />
    <main id={mainLandmarkId}>
      <slot />
    </main>
    <Footer />

    {/* Global lightbox overlay */}
    <LightboxGlobal />
  </body>

  <style is:global>
    html {
      background: #13151a;
      background-size: 224px;
    }

   header {
     position: sticky;
     top: 0;
     height: 60px;
     min-height: 60px;
     z-index: 1000;
   }

    body {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      min-height: 100vh;
      margin: 0;
      background: var(--color-background);
    }
    
    /* This makes the outer layout main take remaining space,
       so the footer stays down without pushing the hero */
    body > main {
      flex: 1;
    }

    main {
      display: flex;
      flex-direction: column;
      gap: 42px;
      color: var(--white);
    }
  </style>
</html>