---
import TitleNav from '../components/TitleNav.astro';

interface Props {
  title: string;
  pages?: any[];
  currentDiscipline?: 'ux' | 'visual' | 'photo' | 'sound';
}

const { title, pages = [] } = Astro.props;
---

<div class='post-page'>
  <div class='layout-container'>
    <TitleNav title={title} pages={pages} />
    <div class='content-container'>
      <slot name='content' />
    </div>
  </div>
</div>

<style>
  .post-page {
    display: flex;
    flex-flow: column;
    gap: 12px;
    align-items: center;

    img {
      width: 100%;
      height: auto;
      margin: 16px 0;
    }
  }

  .layout-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
    padding: 16px 60px;
    margin: 16px 0;
  }

  .content-container {
    max-width: 70ch;
    color: var(--color-post-text);
    background: var(--color-post-background);
    
    hr {
      border: none;
      height: 1px;
      margin: 44px 0; /* more breathing room */
      background-color: rgba(255, 255, 255, 0.18); /* soft off-white */
    }

    > *:not(h2, h3, h4, h5, h6) {
      font-family: 'Source Serif 4', serif;
      font-size: 1.28rem;
      line-height: 1.3;
      font-weight: 375;
      color: #d6d9e0;
    }
    
    h1 {
      font-family: Poppins, sans-serif;
      font-size: 2rem;
      font-weight: 600;
      line-height: 1.25;
    }

    * + h2 {
      margin-top: 25px;
    }

    blockquote {
      padding: 6px 20px;
      margin: 25px 0;
      font-family: Poppins, sans-serif;
      background: #375d80;
    }

    h2,
    h3,
    h4 {
      + :not(h1, h2, h3, h4, h5, h6) {
        margin-top: 8px;
      }
    }

    h2 {
      font-size: 1.75rem;
      font-weight: 600;
      line-height: 1;
    }

    h3 {
      margin-top: 20px;
      font-size: 1.35rem;
      font-weight: 500;
      line-height: 1;
    }

    h4 {
      font-size: 0.9375rem;
    }

    figcaption {
      font-family: Poppins, sans-serif;
      font-size: 0.95rem;
      text-align: center;
    }

    figure {
      margin-bottom: 30px;

      p,
      img {
        margin-bottom: 0;
      }
    }

    li {
      margin-bottom: 1rem;
      line-height: 1.2;
    }

    table {
      border-collapse: collapse;
    }

    table,
    th,
    td {
      border: 1px solid var(--color-post-text);
    }

    th,
    td {
      padding: clamp(8px, 1vw, 20px);
    }
  }
</style>
